{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevGuard",
  "version": "0.1.0",
  "identifier": "com.devguard.desktop",
  "build": {
    "beforeDevCommand": "pnpm agent:install && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm agent:install && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevGuard",
        "width": 1120,
        "height": 800,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../agent/sidecar.mjs": "agent/sidecar.mjs",
      "../agent/package.json": "agent/package.json",
      "../agent/node_modules/": "agent/node_modules/",
      "../agent/tools/": "agent/tools/",
      "../agent/skills/": "agent/skills/",
      "../agent/report.mjs": "agent/report.mjs"
    }
  }
}
